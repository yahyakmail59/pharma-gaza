{
  "$schema": "../athar-console/node_modules/wrangler/config-schema.json",
  "name": "pharma-sync-api",
  "main": "worker/worker.js",
  "compatibility_date": "2026-08-19",
  // مغلق: العناوين المعتمدة على athar.date وحدها.
  //
  // عنوان workers.dev يبقى بابًا ثانيًا للخدمة نفسها: يُفهرس، ويُنسخ في
  // رسالة لعميل، ثم يُعطَّل يومًا فيظهر العطل عند من حفظه لا عندنا. وقد
  // وقع هذا فعلًا — واجهة الصيدلية كانت تناديه فسقط الدخول كله.
  "workers_dev": false,
  // واجهة الصيدلية تُخدم من نفس الأصل. هذا يلغي حاجة CORS بين الواجهة
  // والـAPI، ويعطي كل صيدلية رابطًا عامًا يعمل دون استضافة خارجية.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/internal/*"]
  },
  // مضيف واحد لكل الصيدليات، لا نطاقًا لكل صيدلية.
  //
  // الصيدلية تطبيق مغلق كالمدرسة: لا صفحة عامة، والمستأجر يُحدَّد بـ`?pharmacy=`
  // بعد الدخول لا بالمضيف. والنمط الشامل `*.athar.date` مملوك لمحرك المطاعم،
  // والـslug فريد داخل المنتج لا عبره — فقاعدة أخصّ تغلبه وتتجنّب التصادم.
  "routes": [
    { "pattern": "pharmacy.athar.date/*", "zone_name": "athar.date" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pharma-db",
      "database_id": "bff19fd4-5831-4848-a4f5-1bc3ac281001"
    }
  ],
  "vars": {
    "PUBLIC_APP_URL": "https://pharmacy.athar.date/",
    // العنوانان معًا: الواجهة تُخدم من نفس الأصل فلا تحتاج CORS، لكن رابط
    // workers.dev يبقى عاملًا لمن حفظه — وحذفه من القائمة يحجب الـAPI عنه
    // بينما الصفحة نفسها ما زالت تُفتح، فيظهر العطل كأنه في الدخول.
    "ALLOWED_ORIGINS": "https://pharmacy.athar.date"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
